; AUTO-GENERATED by `theme`; do not edit directly.
(defpoll clock-time :interval "1s" :initial "" `date '+%I:%M %p'`)
(defpoll clock-date :interval "60s" :initial "" `date '+%A, %B %-d, %Y'`)
(defpoll sysinfo :interval "5s" :initial "{\"cpu\":0,\"mem\":\"0/0G\",\"mem_percent\":0,\"disk\":0,\"uptime\":\"\"}" `/home/lakota/.config/eww/homepage/scripts/sysinfo.py`)
(defpoll media :interval "2s" :initial "{\"visible\":false,\"playing\":false,\"status\":\"\",\"status_label\":\"\",\"title\":\"\",\"artist\":\"\",\"album\":\"\",\"art\":\"\"}" `/home/lakota/.config/eww/homepage/scripts/media.py`)
(defpoll workspace-state :interval "1s" :initial "{\"active\":1,\"workspaces\":[1,2,3,4,5]}" `/home/lakota/.config/eww/homepage/scripts/workspaces.py`)
(defvar media-hovered false)

(defwidget clock []
  (box :class "card" :orientation "v" :space-evenly false
    (label :class "clock-time" :halign "start" :text clock-time)
    (label :class "clock-date" :halign "start" :text clock-date)))

(defwidget theme-info []
  (box :class "card" :orientation "v" :space-evenly false
    (label :class "theme-name" :halign "start" :text "cappuccino")
    (label :class "theme-effects" :halign "start" :text "effects: clear")))

(defwidget workspaces []
  (box :class "card" :orientation "h" :space-evenly false
    (for ws in {jq(workspace-state, '.workspaces')}
      (button :class {ws == jq(workspace-state, '.active') ? "workspace-btn workspace-active" : "workspace-btn"}
              :onclick "/home/lakota/.config/eww/homepage/scripts/switch-workspace.py {ws}"
        ws))))

(defwidget sysinfo-widget []
  (box :class "card stats-card" :orientation "v" :space-evenly false
    (box :class "stats-row" :orientation "h" :space-evenly true
      (box :class "stat-item" :orientation "v" :space-evenly false
        (circular-progress :class "stat-ring cpu-ring" :value {sysinfo.cpu} :start-at 75 :thickness 7
          (box :orientation "v" :space-evenly false
            (label :class "stat-icon" :text "󰍛")
            (label :class "stat-value" :text "${sysinfo.cpu}%")))
        (label :class "stat-label" :text "CPU"))
      (box :class "stat-item" :orientation "v" :space-evenly false
        (circular-progress :class "stat-ring mem-ring" :value {sysinfo.mem_percent} :start-at 75 :thickness 7
          (box :orientation "v" :space-evenly false
            (label :class "stat-icon" :text "󰘚")
            (label :class "stat-value" :text "${sysinfo.mem_percent}%")))
        (label :class "stat-label" :text "MEMORY"))
      (box :class "stat-item" :orientation "v" :space-evenly false
        (circular-progress :class "stat-ring disk-ring" :value {sysinfo.disk} :start-at 75 :thickness 7
          (box :orientation "v" :space-evenly false
            (label :class "stat-icon" :text "󰋊")
            (label :class "stat-value" :text "${sysinfo.disk}%")))
        (label :class "stat-label" :text "DISK")))
    (box :class "uptime-panel" :orientation "h" :space-evenly false
      (label :class "uptime-icon" :text "󰔟")
      (box :orientation "v" :space-evenly false
        (label :class "uptime-label" :halign "start" :text "SYSTEM UPTIME")
        (label :class "uptime-value" :halign "start" :text "${sysinfo.uptime}")))))

(defwidget media-widget []
  (eventbox :visible {media.visible}
            :class "media-event"
            :cursor "pointer"
            :onhover "${EWW_CMD} update media-hovered=true"
            :onhoverlost "${EWW_CMD} update media-hovered=false"
    (box :class "card media-card" :orientation "v" :space-evenly false
      (stack :class "media-stage" :selected {media-hovered ? 1 : 0} :transition "crossfade" :same-size true
        (overlay
          (box :class "media-art-fallback" :width 354 :height 202
            (label :class "media-art-icon" :text "󰎈"))
          (image :visible {media.art != ""} :class "media-art-image"
                 :path {media.art != "" ? media.art : "/home/lakota/.config/hypr/wallpapers/cappuccino.png"}
                 :image-width 354 :image-height 202)
          (box :class "media-art-shade")
          (label :class "media-status-pill" :halign "start" :valign "start" :text "${media.status_label}"))
        (box :class "media-hover-layout" :orientation "h" :space-evenly false :width 354 :height 202
          (overlay
            (box :class "media-art-fallback" :width 158 :height 202
              (label :class "media-art-icon" :text "󰎈"))
            (image :visible {media.art != ""} :class "media-art-image"
                   :path {media.art != "" ? media.art : "/home/lakota/.config/hypr/wallpapers/cappuccino.png"}
                   :image-width 158 :image-height 202))
          (box :class "media-info" :orientation "v" :space-evenly false :width 196
            (label :class "media-status" :halign "start" :text "${media.status_label}")
            (label :class "media-title" :halign "start" :limit-width 20 :wrap true :text "${media.title}")
            (label :class "media-artist" :halign "start" :limit-width 22 :text "${media.artist}")
            (box :class "media-controls" :orientation "h" :space-evenly true
              (button :class "media-control" :tooltip "Previous" :onclick "/home/lakota/.config/eww/homepage/scripts/media-control.py previous" "󰒮")
              (button :class "media-control media-control-primary" :tooltip "Play / pause"
                      :onclick "/home/lakota/.config/eww/homepage/scripts/media-control.py play-pause"
                {media.playing ? "󰏤" : "󰐊"})
              (button :class "media-control" :tooltip "Next" :onclick "/home/lakota/.config/eww/homepage/scripts/media-control.py next" "󰒭"))))))))

(defwidget hero []
  (stack :selected {media.visible ? 0 : 1} :transition "crossfade" :same-size true
    (media-widget)
    (box :class "card hero-card" :orientation "v" :space-evenly false :width 640
      (box :class "hero-art" :height 242 (label :class "hero-icon" :text "󰎈"))
      (label :class "hero-title" :halign "start" :text "What are we doing?")
      (label :class "hero-copy" :halign "start" :text "Start something, or resume your music.")
      (box :class "action-row" :orientation "h" :space-evenly false
        (button :class "action-btn" :onclick "wofi --show drun" "Launch")
        (button :class "action-btn" :onclick "foot" "Terminal")
        (button :class "action-btn" :onclick "playerctl play-pause" "Resume")))))

(defwidget right-rail []
  (box :class "dashboard-right" :orientation "v" :space-evenly false :width 330
    (box :class "card" :orientation "v" :space-evenly false
      (label :class "section-title" :halign "start" :text "TODAY")
      (label :class "hero-title" :halign "start" :text "Nothing scheduled")
      (label :class "right-copy" :halign "start" :text "Add agenda.json when you are ready."))
    (box :class "card" :orientation "v" :space-evenly false
      (label :class "section-title" :halign "start" :text "NETWORK & PRIVACY")
      (box :class "status-row" :orientation "h" :space-evenly false (label :class "status-dot" :text "●") (label :class "right-copy" :text "Network status in Waybar"))
      (box :class "status-row" :orientation "h" :space-evenly false (label :class "status-dot" :text "●") (label :class "right-copy" :text "Privacy controls remain available")))
    (box :class "card" :orientation "v" :space-evenly false
      (label :class "section-title" :halign "start" :text "ACTIVE PROJECT")
      (label :class "hero-title" :halign "start" :text "Set a project")
      (label :class "right-copy" :halign "start" :text "Project context will appear here."))))

(defwidget dock []
  (box :class "dock" :orientation "h" :space-evenly false :halign "center"
    (button :class "dock-btn" :tooltip "Applications" :onclick "wofi --show drun" "󰀻")
    (button :class "dock-btn" :tooltip "Terminal" :onclick "foot" "󰆍")
    (button :class "dock-btn" :tooltip "Files" :onclick "thunar" "󰉋")
    (button :class "dock-btn" :tooltip "Screenshot" :onclick "grimblast copysave area" "󰹑")
    (button :class "dock-btn" :tooltip "Power" :onclick "wlogout" "󰐥")))

(defwidget homepage []
  (overlay
    (image :class "homepage-background" :path "/home/lakota/.config/hypr/wallpapers/cappuccino.png" :image-width 1920 :image-height 1200 :hexpand true :vexpand true)
    (box :class "homepage-tint" :hexpand true :vexpand true)
    (box :class "dashboard-root" :orientation "v" :space-evenly false :valign "center" :hexpand true
      (box :orientation "h" :space-evenly false :halign "center" :valign "start"
        (box :orientation "v" :space-evenly false :width 400 (clock) (theme-info) (workspaces) (sysinfo-widget))
        (box :class "dashboard-center" :orientation "v" :space-evenly false :width 640 (hero))
        (right-rail))
      (box :halign "center" (dock)))))

(defwindow homepage
  :monitor 0
  :stacking "bottom"
  :exclusive false
  :focusable false
  :geometry (geometry :x "0%" :y "0%" :width "1920px" :height "1200px" :anchor "top left")
  (homepage))
