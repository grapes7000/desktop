# Repository integration. Override any value in config/local.env or the shell.
DOTFILES_REPO="${DOTFILES_REPO:-https://github.com/grapes7000/dotfiles.git}"
THEMES_REPO="${THEMES_REPO:-https://github.com/grapes7000/themes.git}"
THEMES_DIR="${THEMES_DIR:-$HOME/Projects/setup/themes}"
DEFAULT_THEME="${DEFAULT_THEME:-catppuccin_mocha}"

# Normal defaults. Command-line flags can override these.
INSTALL_FLATPAKS="${INSTALL_FLATPAKS:-1}"
APPLY_DOTFILES="${APPLY_DOTFILES:-1}"
INSTALL_THEMES="${INSTALL_THEMES:-1}"
